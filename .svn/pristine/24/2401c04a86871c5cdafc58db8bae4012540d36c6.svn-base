.employee-list {
    display: flex;
    flex-direction: column; /* ✅ 세로 정렬 */
    gap: 10px;
    align-items: center;
    width: 100%;
}

.employee-card {
    display: flex;
    align-items: center;
    padding: 10px;
    width: 80%;
    max-width: 300px;
    border-radius: 10px;
    background: #f8f9fa;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease-in-out;
    cursor: pointer;
}

.employee-card:hover {
    transform: scale(1.05);
}

.employee-img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 15px;
}

.employee-info {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.employee-name {
    font-weight: bold;
    font-size: 1.1rem;
    color: #333;
}

.employee-title {
    font-size: 0.9rem;
    color: #666;
}

.no-employees {
    text-align: center;
    font-size: 1rem;
    color: #999;
    width: 100%;
}